# Copy to .env.local and fill in from the Supabase project's Connect panel.
VITE_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>
# Server only, bypasses Row Level Security: never prefix it with VITE_.
# Locally, `bunx supabase status` prints the URL and both keys.
SUPABASE_SECRET_KEY=<SUBSTITUTE_SUPABASE_SECRET_KEY>

# Public URL of the app: Apple PassKit Web Service URL, Google Wallet callback
# URL and allowed origin of Google save links. Wallet requires HTTPS (use a
# tunnel in development, or enable Settings > Developer > Allow HTTP Services
# on the iPhone).
APP_URL=http://localhost:3000

# Apple Wallet: Team ID and Pass Type ID from the Apple Developer account.
APPLE_TEAM_ID=<SUBSTITUTE_APPLE_TEAM_ID>
APPLE_PASS_TYPE_ID=pass.<SUBSTITUTE_REVERSE_DOMAIN>
# PEM contents (multi-line in double quotes, or on one line with escaped \n).
# APPLE_WWDR_CERT: Apple WWDR intermediate certificate (G4).
# APPLE_SIGNER_CERT / APPLE_SIGNER_KEY: Pass Type ID certificate and its private key.
APPLE_WWDR_CERT="<SUBSTITUTE_PEM>"
APPLE_SIGNER_CERT="<SUBSTITUTE_PEM>"
APPLE_SIGNER_KEY="<SUBSTITUTE_PEM>"
# Only if the private key is encrypted.
APPLE_SIGNER_KEY_PASSPHRASE=

# Apple Push Notification service, used to tell Wallet that a pass changed.
# Key created in the Apple Developer account (Keys > APNs), `.p8` file content.
# Optional: without it, Apple passes only update when their holder refreshes them.
APNS_KEY_ID=<SUBSTITUTE_APNS_KEY_ID>
APNS_KEY="<SUBSTITUTE_PEM>"

# Google Wallet: Issuer ID from the Google Pay & Wallet Console, and the JSON key
# of a service account allowed to manage the issuer's passes (on one line).
GOOGLE_ISSUER_ID=<SUBSTITUTE_GOOGLE_ISSUER_ID>
GOOGLE_SERVICE_ACCOUNT_JSON=<SUBSTITUTE_SERVICE_ACCOUNT_JSON>

# Marketing messages per program and calendar month (one per 24 hours at most).
# Defaults to 4; 0 turns messages off.
NOTIFICATIONS_MONTHLY_CAP=4
